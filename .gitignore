# OS metadata
.DS_Store
Thumbs.db

# data/ is local: raw logs can be re-fetched from the NBA API and everything else is
# rebuilt from them. Only inputs that cannot be regenerated later are tracked:
# player bio metadata and the season-start bootstrap (roster snapshot, core players,
# initial Elo), which depend on the date they were built.
data/*
!data/reference
data/reference/*
!data/reference/player_metadata.csv
!data/season=2026-27
data/season=2026-27/*
!data/season=2026-27/analysis
data/season=2026-27/analysis/*
!data/season=2026-27/analysis/team_rosters.csv
!data/season=2026-27/analysis/core_players.csv
!data/season=2026-27/analysis/team_elo_initial.json
# Generated frontend data is served by the API from data/frontend_store/; nothing here is tracked.
frontend/public/data/
data/frontend_store/
scratch/
.antigravity/
.claude/
.devin/

# Model binaries are generated artifacts; metadata/schema JSON may stay tracked.
models/**/*.pkl
# Production models are tracked in the repo.
!models/production/*.pkl
models/**/*.joblib
models/**/*.h5
models/**/*.pt
models/**/*.parquet
models/**/replaced_leaky/
models/**/backup/
outputs/
outputs/analysis/

!models/
!outputs/
!notebooks/


# Holdout copies trained without the validation season (retrain gate only)
models/experimental/holdout_eval/

# graphify knowledge graph output
graphify-out/

# Odds API key and licensed odds data
.env
data/raw/odds/
data/odds/

# Run-time reports rewritten by every data update or ad hoc prediction run; tracked copies go stale.
reports/predictions/
reports/operations/data_freshness_report.*
reports/operations/pipeline_sync_report_*.md
reports/operations/local_ingestion_report.md
reports/operations/data_update_report.md
reports/operations/team_model_ready_v3_report.md
reports/audits/opponent_feature_report.md
